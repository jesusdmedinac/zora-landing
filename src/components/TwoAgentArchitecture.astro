---
import type { TranslationDictionary } from '../i18n/translations';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
---

<section class="agents-section" id="como-funciona">
  <!-- Section Header -->
  <div class="section-header">
    <span class="badge-metal badge-spectrum">
      {t.agents.badge}
    </span>
    <h2 class="section-title">
      {t.agents.title}
    </h2>
    <p class="section-subtitle">
      {t.agents.subtitle}
    </p>
  </div>

  <!-- Dual Cards Grid with Central Bridge -->
  <div class="agents-grid">
    <!-- Card 1: Driver Copilot Agent -->
    <div class="agent-card titanium-card">
      <div class="agent-card-header">
        <div class="agent-badge-box">
          <span class="led-diode led-violet"></span>
          <span class="agent-role">{t.agents.driverAgent.role}</span>
        </div>
        <h3 class="agent-card-title">{t.agents.driverAgent.title}</h3>
        <p class="agent-card-desc">{t.agents.driverAgent.description}</p>
      </div>

      <ul class="agent-points-list">
        {t.agents.driverAgent.points.map((pt) => (
          <li class="agent-point-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{pt}</span>
          </li>
        ))}
      </ul>

      <!-- Interactive Dialogue Sample -->
      <div class="agent-sample-dialogue">
        <div class="dialogue-chip dialogue-chip-user">
          <span class="chip-avatar">DRIVER</span>
          <p class="chip-bubble">{t.agents.driverAgent.samplePrompt}</p>
        </div>
        <div class="dialogue-arrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
          <span>NLP TRANSLATION</span>
        </div>
        <div class="dialogue-chip dialogue-chip-ai">
          <span class="chip-avatar-ai">ZORA COPILOT</span>
          <p class="chip-bubble-ai">{t.agents.driverAgent.parsedOutput}</p>
        </div>
      </div>
    </div>

    <!-- Central Connecting Node (Visible on Desktop) -->
    <div class="central-bridge">
      <div class="bridge-line"></div>
      <div class="bridge-core">
        <img src="/images/zora-transparent.svg" alt="Core Sync" width="22" height="22" />
        <span class="bridge-label">KTOR HIGH-SPEED WS SYNC</span>
      </div>
      <div class="bridge-line"></div>
    </div>

    <!-- Card 2: Yonke Radar Agent -->
    <div class="agent-card titanium-card">
      <div class="agent-card-header">
        <div class="agent-badge-box">
          <span class="led-diode led-emerald"></span>
          <span class="agent-role agent-role-yard">{t.agents.yonkeAgent.role}</span>
        </div>
        <h3 class="agent-card-title">{t.agents.yonkeAgent.title}</h3>
        <p class="agent-card-desc">{t.agents.yonkeAgent.description}</p>
      </div>

      <ul class="agent-points-list">
        {t.agents.yonkeAgent.points.map((pt) => (
          <li class="agent-point-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon check-icon-emerald">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{pt}</span>
          </li>
        ))}
      </ul>

      <!-- Interactive Alert Sample -->
      <div class="agent-sample-dialogue">
        <div class="dialogue-chip dialogue-chip-radar">
          <span class="chip-avatar-radar">RADAR ALERT</span>
          <p class="chip-bubble">{t.agents.yonkeAgent.sampleAlert}</p>
        </div>
        <div class="dialogue-arrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
          <span>FASTEST-FINGER-FIRST (1 CLICK)</span>
        </div>
        <div class="dialogue-chip dialogue-chip-quote">
          <span class="chip-avatar-quote">VERIFIED YARD</span>
          <p class="chip-bubble-quote">{t.agents.yonkeAgent.fastestQuote}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .agents-section {
    padding: 72px 0;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    margin: 16px 0 12px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
  }

  .agents-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .agent-card {
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .agent-badge-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .agent-role {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #c49eff;
  }

  .agent-role-yard {
    color: #34d399;
  }

  .agent-card-title {
    font-size: 1.45rem;
    margin-bottom: 8px;
  }

  .agent-card-desc {
    font-size: 0.92rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    margin-bottom: 24px;
  }

  .agent-points-list {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .agent-point-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--text-laser-white);
    line-height: 1.45;
  }

  .check-icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--zora-magenta);
  }

  .check-icon-emerald {
    color: var(--radar-emerald);
  }

  /* Dialogue Box */
  .agent-sample-dialogue {
    background: rgba(9, 10, 13, 0.9);
    border: 1px solid var(--chamfer-subtle);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dialogue-chip {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.82rem;
  }

  .chip-avatar {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-engraved);
    display: block;
    margin-bottom: 4px;
  }

  .chip-avatar-ai {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--zora-magenta);
    display: block;
    margin-bottom: 4px;
  }

  .chip-avatar-radar {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--radar-amber);
    display: block;
    margin-bottom: 4px;
  }

  .chip-avatar-quote {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--radar-emerald);
    display: block;
    margin-bottom: 4px;
  }

  .chip-bubble {
    color: var(--text-laser-white);
    line-height: 1.4;
  }

  .chip-bubble-ai {
    color: #e9d5ff;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .chip-bubble-quote {
    color: #d1fae5;
    font-weight: 600;
    line-height: 1.4;
  }

  .dialogue-chip-user {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dialogue-chip-ai {
    background: rgba(138, 77, 255, 0.1);
    border: 1px solid rgba(138, 77, 255, 0.3);
  }

  .dialogue-chip-radar {
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .dialogue-chip-quote {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .dialogue-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-engraved);
  }

  /* Central Bridge */
  .central-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .bridge-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(180deg, transparent 0%, rgba(167, 50, 253, 0.4) 50%, transparent 100%);
  }

  .bridge-core {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px;
    border-radius: 12px;
    background: var(--metal-titanium);
    border: 1px solid var(--chamfer-subtle);
  }

  .bridge-label {
    writing-mode: vertical-lr;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-engraved);
    letter-spacing: 0.08em;
  }

  @media (max-width: 960px) {
    .agents-grid {
      grid-template-columns: 1fr;
    }
    .central-bridge {
      display: none;
    }
  }
</style>
