---
import type { TranslationDictionary } from '../i18n/translations';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
---

<section class="trust-section">
  <!-- Header -->
  <div class="section-header">
    <span class="badge-metal badge-radar">
      <span class="led-diode led-emerald"></span>
      {t.trust.badge}
    </span>
    <h2 class="section-title">
      {t.trust.title}
    </h2>
    <p class="section-subtitle">
      {t.trust.subtitle}
    </p>
  </div>

  <!-- Trust Features Grid -->
  <div class="trust-grid">
    {t.trust.features.map((item, idx) => (
      <div class="trust-card titanium-card">
        <div class="trust-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="trust-icon">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="trust-title">{item.title}</h3>
        <p class="trust-desc">{item.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-section {
    padding: 72px 0;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    margin: 16px 0 12px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .trust-card {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
  }

  .trust-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .trust-icon {
    color: var(--radar-emerald);
  }

  .trust-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-laser-white);
    margin-bottom: 10px;
    line-height: 1.35;
  }

  .trust-desc {
    font-size: 0.88rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
