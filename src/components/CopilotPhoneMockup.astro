---
import type { TranslationDictionary } from '../i18n/translations';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
---

<section class="mockup-section" id="experiencia">
  <!-- Header -->
  <div class="section-header">
    <span class="badge-metal badge-spectrum">
      {t.phoneMockup.badge}
    </span>
    <h2 class="section-title">
      {t.phoneMockup.title}
    </h2>
    <p class="section-subtitle">
      {t.phoneMockup.subtitle}
    </p>
  </div>

  <!-- Interactive Mockup Stage -->
  <div class="mockup-stage">
    <!-- Interactive Tab Selector Bar -->
    <div class="tab-controls">
      <button class="mockup-tab active" data-tab="copilot">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>{t.phoneMockup.tabs.copilot}</span>
      </button>

      <button class="mockup-tab" data-tab="garage">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>{t.phoneMockup.tabs.garage}</span>
      </button>

      <button class="mockup-tab" data-tab="parts">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>{t.phoneMockup.tabs.parts}</span>
      </button>
    </div>

    <!-- Phone Chassis Frame -->
    <div class="phone-frame">
      <!-- Dynamic Island / Speaker Notch -->
      <div class="phone-top-bar">
        <div class="phone-time">9:41</div>
        <div class="dynamic-island">
          <span class="island-dot"></span>
          <span class="island-brand">ZORA RADAR</span>
        </div>
        <div class="phone-icons">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4a1 1 0 0 0 1.41 1.41l1.79-.62C9.13 21.26 10.53 22 12 22c4.97 0 9-4.03 9-9s-4.03-9-9-9z"></path>
          </svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17 4h-3V2h-4v2H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"></path>
          </svg>
        </div>
      </div>

      <!-- Phone Screen Viewport -->
      <div class="phone-viewport">
        <!-- View 1: Copilot Chat -->
        <div id="view-copilot" class="phone-view active">
          <!-- Chat Top Nav -->
          <div class="app-header">
            <div class="app-profile">
              <div class="app-avatar-box">
                <img src="/images/zora-transparent.svg" alt="Zora" width="18" height="18" />
              </div>
              <div class="app-title-group">
                <span class="app-title">Zora Copilot</span>
                <span class="app-status">
                  <span class="led-diode led-emerald"></span> En línea &bull; Modelo Gemini
                </span>
              </div>
            </div>
          </div>

          <!-- Messages Stream -->
          <div class="chat-messages">
            <!-- User Bubble -->
            <div class="msg-bubble user-msg">
              <p>{t.phoneMockup.copilotTab.driverQuery}</p>
              <span class="msg-time">09:38</span>
            </div>

            <!-- Assistant Bubble with Generative Diagnostic Card -->
            <div class="msg-bubble assistant-msg">
              <div class="assistant-content">
                <p>{t.phoneMockup.copilotTab.aiResponse}</p>

                <!-- Embedded Generative Card -->
                <div class="gen-diagnostic-card">
                  <div class="gen-badge-row">
                    <span class="gen-badge-highlight">{t.phoneMockup.copilotTab.diagBadge}</span>
                    <span class="gen-badge-fit">DIRECT FIT</span>
                  </div>
                  <p class="gen-part-code">{t.phoneMockup.copilotTab.partCode}</p>
                  <div class="gen-action-strip">
                    <button class="btn-primary gen-btn">Alertar a Yonkes</button>
                    <span class="gen-tag">Compatibilidad 100%</span>
                  </div>
                </div>
              </div>
              <span class="msg-time">09:39</span>
            </div>
          </div>
        </div>

        <!-- View 2: Virtual Garage -->
        <div id="view-garage" class="phone-view">
          <div class="app-header">
            <span class="app-title">Garaje Virtual &amp; Bóveda</span>
            <span class="badge-metal badge-spectrum">1/1 SLOTS</span>
          </div>

          <div class="garage-content">
            <!-- Vehicle Card -->
            <div class="vehicle-card titanium-card">
              <div class="vehicle-card-top">
                <div class="car-info">
                  <span class="car-vin">VIN: 2HKRM4H58GH02****</span>
                  <h4 class="car-name">{t.phoneMockup.garageTab.vehicle}</h4>
                </div>
                <div class="health-pill">
                  <span class="health-val">94%</span>
                  <span class="health-lbl">SALUD</span>
                </div>
              </div>
              <div class="garage-divider"></div>
              <div class="telemetry-box">
                <span class="telemetry-badge">
                  <span class="led-diode led-emerald"></span>
                  {t.phoneMockup.garageTab.telemetryNotice}
                </span>
                <p class="telemetry-desc">{t.phoneMockup.garageTab.fluidsStatus}</p>
                <div class="maintenance-pill">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{t.phoneMockup.garageTab.nextCheck}</span>
                </div>
              </div>
            </div>

            <!-- Memory Slots Storage -->
            <div class="memory-vault-box">
              <span class="vault-title">MEMORIA LOCAL (SQLDELIGHT)</span>
              <div class="memory-item">
                <span>Registro de Triage #810</span>
                <span class="memory-tag">GUARDADO</span>
              </div>
              <div class="memory-item">
                <span>Perfil de Aceite Motor 0W-20</span>
                <span class="memory-tag">ACTIVO</span>
              </div>
            </div>
          </div>
        </div>

        <!-- View 3: Contextual Parts & Radar Feed -->
        <div id="view-parts" class="phone-view">
          <div class="app-header">
            <span class="app-title">Radar de Piezas &amp; Ofertas</span>
            <span class="badge-metal badge-radar">3 EN RADAR</span>
          </div>

          <div class="parts-feed">
            <!-- Live Salvage Offer 1 -->
            <div class="part-card titanium-card">
              <div class="part-card-header">
                <span class="part-status-badge">
                  <span class="led-diode led-emerald"></span>
                  {t.phoneMockup.partsTab.status}
                </span>
                <span class="part-savings">{t.phoneMockup.partsTab.savings}</span>
              </div>
              <h4 class="part-title">{t.phoneMockup.partsTab.partName}</h4>
              <p class="part-yard">{t.phoneMockup.partsTab.yardName}</p>
              <div class="part-price-row">
                <span class="part-price">{t.phoneMockup.partsTab.price}</span>
                <button class="btn-primary part-buy-btn">Ver Fotos &amp; Comprar</button>
              </div>
            </div>

            <!-- Live Salvage Offer 2 -->
            <div class="part-card titanium-card">
              <div class="part-card-header">
                <span class="part-status-badge">
                  <span class="led-diode led-emerald"></span>
                  OTAY RECYCLERS
                </span>
                <span class="part-savings">Ahorro: 62%</span>
              </div>
              <h4 class="part-title">Semieje Delantero Izquierdo con Junta</h4>
              <p class="part-yard">Yonke El Águila - Tijuana / San Diego</p>
              <div class="part-price-row">
                <span class="part-price">$90 USD ($1,650 MXN)</span>
                <button class="btn-secondary part-buy-btn">Revisar</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mockup-section {
    padding: 72px 0;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 36px;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    margin: 16px 0 12px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
  }

  .mockup-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* Tab Controls */
  .tab-controls {
    display: flex;
    gap: 8px;
    background: rgba(15, 17, 21, 0.8);
    padding: 6px;
    border-radius: 12px;
    border: 1px solid var(--chamfer-subtle);
  }

  .mockup-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-metal-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mockup-tab.active {
    background: rgba(138, 77, 255, 0.15);
    color: var(--text-laser-white);
    border: 1px solid rgba(138, 77, 255, 0.35);
  }

  /* Phone Frame Container */
  .phone-frame {
    width: 100%;
    max-width: 410px;
    height: 720px;
    background: #090a0d;
    border-radius: 46px;
    border: 10px solid #1f232b;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8),
                0 0 0 1px rgba(255, 255, 255, 0.1),
                0 0 35px -5px rgba(138, 77, 255, 0.2);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .phone-top-bar {
    height: 48px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-laser-white);
    font-weight: 600;
    z-index: 10;
  }

  .dynamic-island {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #000000;
    padding: 4px 12px;
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
  }

  .island-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--radar-emerald);
  }

  .phone-icons {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .phone-viewport {
    flex: 1;
    overflow-y: auto;
    position: relative;
    background: #0f1115;
  }

  .phone-view {
    display: none;
    height: 100%;
    flex-direction: column;
    padding: 16px;
  }

  .phone-view.active {
    display: flex;
  }

  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--chamfer-subtle);
    margin-bottom: 14px;
  }

  .app-profile {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .app-avatar-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(138, 77, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(138, 77, 255, 0.4);
  }

  .app-title-group {
    display: flex;
    flex-direction: column;
  }

  .app-title {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-laser-white);
  }

  .app-status {
    font-size: 0.68rem;
    color: var(--text-metal-secondary);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* Chat Messages */
  .chat-messages {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .msg-bubble {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 0.82rem;
    line-height: 1.45;
    position: relative;
  }

  .user-msg {
    align-self: flex-end;
    background: var(--zora-gradient);
    color: #ffffff;
    border-bottom-right-radius: 2px;
  }

  .assistant-msg {
    align-self: flex-start;
    background: #16181d;
    border: 1px solid var(--chamfer-subtle);
    color: var(--text-laser-white);
    border-bottom-left-radius: 2px;
  }

  .msg-time {
    font-size: 0.62rem;
    font-family: var(--font-mono);
    opacity: 0.6;
    display: block;
    margin-top: 4px;
    text-align: right;
  }

  /* Generative Diagnostic Card inside Chat */
  .gen-diagnostic-card {
    margin-top: 10px;
    background: #090a0d;
    border: 1px solid rgba(138, 77, 255, 0.35);
    border-radius: 8px;
    padding: 10px;
  }

  .gen-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .gen-badge-highlight {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--zora-magenta);
  }

  .gen-badge-fit {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }

  .gen-part-code {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-laser-white);
    margin-bottom: 8px;
    line-height: 1.35;
  }

  .gen-action-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .gen-btn {
    min-height: 32px;
    font-size: 0.72rem;
    padding: 0 12px;
  }

  .gen-tag {
    font-size: 0.65rem;
    color: var(--text-metal-secondary);
  }

  /* Garage View */
  .garage-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .vehicle-card {
    padding: 14px;
  }

  .vehicle-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .car-vin {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-engraved);
  }

  .car-name {
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 2px;
  }

  .health-pill {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 8px;
    padding: 4px 8px;
    text-align: center;
  }

  .health-val {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    color: #34d399;
    display: block;
  }

  .health-lbl {
    font-size: 0.55rem;
    font-family: var(--font-mono);
    color: #34d399;
  }

  .garage-divider {
    height: 1px;
    background: var(--chamfer-subtle);
    margin: 12px 0;
  }

  .telemetry-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #34d399;
    margin-bottom: 6px;
  }

  .telemetry-desc {
    font-size: 0.78rem;
    color: var(--text-metal-secondary);
    margin-bottom: 8px;
  }

  .maintenance-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    color: var(--text-laser-white);
    background: rgba(255, 255, 255, 0.04);
    padding: 6px 10px;
    border-radius: 6px;
  }

  .memory-vault-box {
    background: #090a0d;
    border: 1px solid var(--chamfer-subtle);
    border-radius: 12px;
    padding: 12px;
  }

  .vault-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-engraved);
    display: block;
    margin-bottom: 8px;
  }

  .memory-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .memory-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #c49eff;
  }

  /* Parts View */
  .parts-feed {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .part-card {
    padding: 12px;
  }

  .part-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .part-status-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #34d399;
  }

  .part-savings {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--zora-magenta);
    font-weight: 700;
  }

  .part-title {
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .part-yard {
    font-size: 0.74rem;
    color: var(--text-metal-secondary);
    margin-bottom: 10px;
  }

  .part-price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .part-price {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-laser-white);
  }

  .part-buy-btn {
    min-height: 32px;
    font-size: 0.72rem;
    padding: 0 12px;
  }
</style>

<script>
  const tabs = document.querySelectorAll('.mockup-tab');
  const views = document.querySelectorAll('.phone-view');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabTarget = tab.getAttribute('data-tab');
      tabs.forEach((t) => t.classList.remove('active'));
      views.forEach((v) => v.classList.remove('active'));

      tab.classList.add('active');
      const targetView = document.getElementById(`view-${tabTarget}`);
      if (targetView) {
        targetView.classList.add('active');
      }
    });
  });
</script>
