---
import type { TranslationDictionary } from '../i18n/translations';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
---

<section class="mockup-section" id="experiencia">
  <!-- Header -->
  <div class="section-header">
    <span class="badge-metal badge-spectrum">
      {t.phoneMockup.badge}
    </span>
    <h2 class="section-title">
      {t.phoneMockup.title}
    </h2>
    <p class="section-subtitle">
      {t.phoneMockup.subtitle}
    </p>
  </div>

  <!-- Interactive Mockup Stage -->
  <div class="mockup-stage">
    <!-- Interactive Tab Selector Bar -->
    <div class="tab-controls">
      <button class="mockup-tab active" data-tab="copilot">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>{t.phoneMockup.tabs.copilot}</span>
      </button>

      <button class="mockup-tab" data-tab="garage">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>{t.phoneMockup.tabs.garage}</span>
      </button>

      <button class="mockup-tab" data-tab="parts">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>{t.phoneMockup.tabs.parts}</span>
      </button>
    </div>

    <!-- Phone Chassis Frame -->
    <div class="phone-frame">
      <!-- Phone Screen Viewport -->
      <div class="phone-viewport">
        <!-- View 1: Copilot Chat -->
        <img id="view-copilot" class="phone-view active" src="/images/zora-ss/zora-ss-03-Onboarding-Chat-iPhone-18-Pro-Max.png"/>

        <!-- View 2: Virtual Garage -->
        <img id="view-garage" class="phone-view" src="/images/zora-ss/zora-ss-06-Garage-Virtual-iPhone-18-Pro-Max.png"/>

        <!-- View 3: Contextual Parts & Radar Feed -->
        <img id="view-parts" class="phone-view" src="/images/zora-ss/zora-ss-07-Yonke-Virtual-&-Refacciones-iPhone-18-Pro-Max.png"/>
      </div>
    </div>
  </div>
</section>

<style>
  .mockup-section {
    padding: 72px 0;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 36px;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    margin: 16px 0 12px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
  }

  .mockup-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* Tab Controls */
  .tab-controls {
    display: flex;
    gap: 8px;
    background: rgba(15, 17, 21, 0.8);
    padding: 6px;
    border-radius: 12px;
    border: 1px solid var(--chamfer-subtle);
  }

  .mockup-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-metal-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mockup-tab.active {
    background: rgba(138, 77, 255, 0.15);
    color: var(--text-laser-white);
    border: 1px solid rgba(138, 77, 255, 0.35);
  }

  /* Phone Frame Container */
  .phone-frame {
    width: 100%;
    max-width: 410px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .phone-top-bar {
    height: 48px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-laser-white);
    font-weight: 600;
    z-index: 10;
  }

  .phone-viewport {
    flex: 1;
    overflow-y: auto;
    position: relative;
  }

  .phone-view {
    display: none;
    height: 100%;
    flex-direction: column;
    padding: 16px;
  }

  .phone-view.active {
    display: flex;
  }

  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--chamfer-subtle);
    margin-bottom: 14px;
  }

  .app-profile {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .app-avatar-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(138, 77, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(138, 77, 255, 0.4);
  }

  .app-title-group {
    display: flex;
    flex-direction: column;
  }

  .app-title {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-laser-white);
  }

  .app-status {
    font-size: 0.68rem;
    color: var(--text-metal-secondary);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* Chat Messages */
  .chat-messages {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .msg-bubble {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 0.82rem;
    line-height: 1.45;
    position: relative;
  }

  .user-msg {
    align-self: flex-end;
    background: var(--zora-gradient);
    color: #ffffff;
    border-bottom-right-radius: 2px;
  }

  .assistant-msg {
    align-self: flex-start;
    background: #16181d;
    border: 1px solid var(--chamfer-subtle);
    color: var(--text-laser-white);
    border-bottom-left-radius: 2px;
  }

  .msg-time {
    font-size: 0.62rem;
    font-family: var(--font-mono);
    opacity: 0.6;
    display: block;
    margin-top: 4px;
    text-align: right;
  }

  /* Generative Diagnostic Card inside Chat */
  .gen-diagnostic-card {
    margin-top: 10px;
    background: #090a0d;
    border: 1px solid rgba(138, 77, 255, 0.35);
    border-radius: 8px;
    padding: 10px;
  }

  .gen-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .gen-badge-highlight {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--zora-magenta);
  }

  .gen-badge-fit {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }

  .gen-part-code {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-laser-white);
    margin-bottom: 8px;
    line-height: 1.35;
  }

  .gen-action-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .gen-btn {
    min-height: 32px;
    font-size: 0.72rem;
    padding: 0 12px;
  }

  .gen-tag {
    font-size: 0.65rem;
    color: var(--text-metal-secondary);
  }

  /* Garage View */
  .garage-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .vehicle-card {
    padding: 14px;
  }

  .vehicle-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .car-vin {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-engraved);
  }

  .car-name {
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 2px;
  }

  .health-pill {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 8px;
    padding: 4px 8px;
    text-align: center;
  }

  .health-val {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    color: #34d399;
    display: block;
  }

  .health-lbl {
    font-size: 0.55rem;
    font-family: var(--font-mono);
    color: #34d399;
  }

  .garage-divider {
    height: 1px;
    background: var(--chamfer-subtle);
    margin: 12px 0;
  }

  .telemetry-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #34d399;
    margin-bottom: 6px;
  }

  .telemetry-desc {
    font-size: 0.78rem;
    color: var(--text-metal-secondary);
    margin-bottom: 8px;
  }

  .maintenance-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    color: var(--text-laser-white);
    background: rgba(255, 255, 255, 0.04);
    padding: 6px 10px;
    border-radius: 6px;
  }

  .memory-vault-box {
    background: #090a0d;
    border: 1px solid var(--chamfer-subtle);
    border-radius: 12px;
    padding: 12px;
  }

  .vault-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-engraved);
    display: block;
    margin-bottom: 8px;
  }

  .memory-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .memory-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #c49eff;
  }

  /* Parts View */
  .parts-feed {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .part-card {
    padding: 12px;
  }

  .part-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .part-status-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #34d399;
  }

  .part-savings {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--zora-magenta);
    font-weight: 700;
  }

  .part-title {
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .part-yard {
    font-size: 0.74rem;
    color: var(--text-metal-secondary);
    margin-bottom: 10px;
  }

  .part-price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .part-price {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-laser-white);
  }

  .part-buy-btn {
    min-height: 32px;
    font-size: 0.72rem;
    padding: 0 12px;
  }
</style>

<script>
  const tabs = document.querySelectorAll('.mockup-tab');
  const views = document.querySelectorAll('.phone-view');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabTarget = tab.getAttribute('data-tab');
      tabs.forEach((t) => t.classList.remove('active'));
      views.forEach((v) => v.classList.remove('active'));

      tab.classList.add('active');
      const targetView = document.getElementById(`view-${tabTarget}`);
      if (targetView) {
        targetView.classList.add('active');
      }
    });
  });
</script>
