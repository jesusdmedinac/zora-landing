---
import type { TranslationDictionary } from '../i18n/translations';

interface Props {
  t: TranslationDictionary;
  lang: 'es' | 'en';
}

const { t, lang } = Astro.props;
const otherLang = lang === 'es' ? 'en' : 'es';
const otherLangLabel = lang === 'es' ? 'EN' : 'ES';
const currentLangLabel = lang === 'es' ? 'ES' : 'EN';
---

<header class="top-nav-wrapper">
  <nav class="top-nav" aria-label="Main Navigation">
    <!-- Brand / Origami Emblem -->
    <a href="#" class="brand-link" aria-label="Zora Home">
      <img src="/images/zora-transparent.svg" alt="Zora Logo" width="28" height="28" class="brand-logo" />
      <span class="brand-name">ZORA</span>
      <span class="brand-sub">COPILOT &amp; YONKES</span>
    </a>

    <!-- Navigation Links -->
    <div class="nav-links">
      <a href="#como-funciona" class="nav-link">{t.nav.howItWorks}</a>
      <a href="#licitacion" class="nav-link">{t.nav.reverseBidding}</a>
      <a href="#experiencia" class="nav-link">{t.nav.virtualGarage}</a>
      <a href="#para-yonkes" class="nav-link nav-link-yard">{t.nav.forYonkes}</a>
    </div>

    <!-- Actions: Language Toggle & CTA -->
    <div class="nav-actions">
      <!-- Language Switcher -->
      <button id="lang-toggle-btn" class="lang-switch-btn" aria-label="Switch Language" data-lang={lang}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="lang-active">{currentLangLabel}</span>
        <span class="lang-divider">/</span>
        <span class="lang-inactive">{otherLangLabel}</span>
      </button>

      <!-- Primary Action -->
      <a href="#buscar" class="btn-primary nav-cta">
        <span>{t.nav.searchCTA}</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .top-nav-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 16px 24px;
    background: rgba(9, 10, 13, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--chamfer-subtle);
  }

  .top-nav {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text-laser-white);
  }

  .brand-logo {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 10px rgba(167, 50, 253, 0.4));
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-laser-white);
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-metal-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    color: var(--text-metal-secondary);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text-laser-white);
  }

  .nav-link-yard {
    color: #34d399;
  }

  .nav-link-yard:hover {
    color: #6ee7b7;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .lang-switch-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(22, 24, 29, 0.7);
    border: 1px solid var(--chamfer-subtle);
    border-radius: 8px;
    color: var(--text-laser-white);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lang-switch-btn:hover {
    background: rgba(30, 34, 42, 0.9);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .lang-active {
    color: var(--text-laser-white);
    font-weight: 700;
  }

  .lang-divider {
    color: var(--text-engraved);
  }

  .lang-inactive {
    color: var(--text-metal-secondary);
  }

  .nav-cta {
    padding: 0 18px;
    min-height: 40px;
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
    .brand-sub {
      display: none;
    }
  }
</style>
