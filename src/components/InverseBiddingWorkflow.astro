---
import type { TranslationDictionary } from '../i18n/translations';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
---

<section class="bidding-section" id="licitacion">
  <!-- Section Header -->
  <div class="section-header">
    <span class="badge-metal badge-spectrum">
      {t.reverseAuction.badge}
    </span>
    <h2 class="section-title">
      {t.reverseAuction.title}
    </h2>
    <p class="section-subtitle">
      {t.reverseAuction.subtitle}
    </p>
  </div>

  <!-- 4-Step Process Visualizer -->
  <div class="steps-grid">
    {t.reverseAuction.steps.map((step) => (
      <div class="step-card titanium-card">
        <div class="step-number-box">
          <span class="step-num">{step.stepNumber}</span>
          <span class="step-line"></span>
        </div>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-desc">{step.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .bidding-section {
    padding: 72px 0;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    margin: 16px 0 12px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .step-card {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
  }

  .step-number-box {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--zora-magenta);
    line-height: 1;
  }

  .step-line {
    flex: 1;
    height: 1px;
    background: var(--chamfer-subtle);
  }

  .step-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-laser-white);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .step-desc {
    font-size: 0.88rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
