---
import '../styles/global.css';
import AmbientShaderCanvas from '../components/AmbientShaderCanvas.astro';
import TopNav from '../components/TopNav.astro';
import HeroSection from '../components/HeroSection.astro';
import TwoAgentArchitecture from '../components/TwoAgentArchitecture.astro';
import CopilotPhoneMockup from '../components/CopilotPhoneMockup.astro';
import InverseBiddingWorkflow from '../components/InverseBiddingWorkflow.astro';
import YonkeRadarSection from '../components/YonkeRadarSection.astro';
import CrossBorderSection from '../components/CrossBorderSection.astro';
import TrustAndVerification from '../components/TrustAndVerification.astro';
import FooterSection from '../components/FooterSection.astro';
import { translations } from '../i18n/translations';

const lang = 'es';
const t = translations[lang];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>Zora | Copiloto de IA Automotriz & Red de Yonkes en Tiempo Real</title>
    <meta
      name="description"
      content="Encuentra refacciones garantizadas para tu auto sin recorrer la ciudad. Copiloto de IA para diagnóstico y licitación inversa en tiempo real con yonkes certificados en Tijuana y San Diego."
    />

    <!-- Open Graph -->
    <meta property="og:title" content="Zora | Copiloto Automotriz & Red de Yonkes" />
    <meta
      property="og:description"
      content="Licitación inversa y diagnóstico de refacciones por IA. Conectamos conductores con deshuesaderos y recicladores certificados en la frontera Tijuana - San Diego."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zora.jesusdmedinac.com" />
    <meta property="og:image" content="https://zora.jesusdmedinac.com/images/zora-dark.png" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebApplication",
            "@id": "https://zora.jesusdmedinac.com/#app",
            "name": "Zora Automotive Marketplace & AI Copilot",
            "url": "https://zora.jesusdmedinac.com",
            "applicationCategory": "AutomotiveApplication",
            "operatingSystem": "Android, iOS, Web",
            "description": "AI-powered automotive marketplace connecting drivers with certified salvage yards across the US-Mexico border corridor via reverse bidding."
          },
          {
            "@type": "Organization",
            "@id": "https://zora.jesusdmedinac.com/#organization",
            "name": "Zora",
            "url": "https://zora.jesusdmedinac.com",
            "logo": "https://zora.jesusdmedinac.com/images/zora-transparent.svg",
            "founder": {
              "@type": "Person",
              "name": "Jesús Daniel Medina Cruz",
              "url": "https://jesusdmedinac.com"
            }
          }
        ]
      }
    </script>
  </head>
  <body>
    <!-- WebGL Ambient Glow Background -->
    <AmbientShaderCanvas />

    <!-- Top Navigation -->
    <TopNav t={t} lang={lang} />

    <!-- Main Content Container -->
    <main class="page-container">
      <HeroSection t={t} />
      <TwoAgentArchitecture t={t} />
      <CopilotPhoneMockup t={t} />
      <InverseBiddingWorkflow t={t} />
      <YonkeRadarSection t={t} />
      <CrossBorderSection t={t} />
      <TrustAndVerification t={t} />
    </main>

    <!-- Footer & CTA -->
    <FooterSection t={t} />

    <!-- Client-Side Language Switch Navigation -->
    <script>
      const langBtn = document.getElementById('lang-toggle-btn');
      if (langBtn) {
        langBtn.addEventListener('click', () => {
          const current = langBtn.getAttribute('data-lang');
          if (current === 'es') {
            window.location.href = '/en/';
          } else {
            window.location.href = '/';
          }
        });
      }
    </script>
  </body>
</html>
